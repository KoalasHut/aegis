{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core preservation scenario file",
  "description": "A file is a list of stack-neutral scenarios owned by one bounded context.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^SC-[A-Z][A-Z0-9-]*-[0-9]{3}$"},
      "title": {"type": "string", "minLength": 1},
      "exercises": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^BR-[A-Z][A-Z0-9-]*-[0-9]{3}$"}
      },
      "verification": {"enum": ["automated", "manual"]},
      "given": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clock": {"type": "string", "format": "date-time"},
          "actor": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
          "commands": {
            "type": "array",
            "items": {"$ref": "#/$defs/operation"}
          },
          "seed": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contract": {"type": "string", "minLength": 1},
              "input": {"type": "object"}
            },
            "required": ["contract", "input"]
          }
        }
      },
      "when": {
        "oneOf": [
          {"$ref": "#/$defs/commandOperation"},
          {"$ref": "#/$defs/queryOperation"}
        ]
      },
      "then": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "output": {"type": "object"},
          "error": {"type": "string", "minLength": 1},
          "events": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*@[0-9]+$"}
          },
          "observe": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {"type": "string", "minLength": 1},
                "input": {"type": "object"},
                "expect": {"type": "object"}
              },
              "required": ["query", "input", "expect"]
            }
          }
        },
        "oneOf": [
          {"required": ["output"]},
          {"required": ["error"]}
        ]
      }
    },
    "required": ["id", "title", "exercises", "verification", "given", "when", "then"]
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "input": {"type": "object"}
      },
      "required": ["command", "input"]
    },
    "commandOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "input": {"type": "object"}
      },
      "required": ["command", "input"]
    },
    "queryOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "input": {"type": "object"}
      },
      "required": ["query", "input"]
    }
  }
}
