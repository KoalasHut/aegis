{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/framework/language/schemas/scenario.schema.json",
  "title": "Core preservation scenario file",
  "description": "A YAML file is a non-empty list of stack-neutral context-owned scenarios.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/scenario" },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/scenarioId" },
        "title": { "type": "string", "minLength": 1 },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ruleId" }
        },
        "verification": { "enum": ["automated", "manual"] },
        "given": { "$ref": "#/$defs/given" },
        "when": {
          "oneOf": [
            { "$ref": "#/$defs/commandOperation" },
            { "$ref": "#/$defs/queryOperation" }
          ]
        },
        "then": { "$ref": "#/$defs/then" }
      },
      "required": ["id", "title", "exercises", "verification", "given", "when", "then"]
    },
    "given": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock": { "type": "string", "format": "date-time" },
        "actor": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "object", "minProperties": 1 }
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/commandStep" },
              { "$ref": "#/$defs/advanceClockStep" }
            ]
          }
        },
        "commands": {
          "description": "Legacy 0.2.x shorthand. Migrate to the ordered given.steps form.",
          "type": "array",
          "items": { "$ref": "#/$defs/commandStep" }
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contract": { "type": "string", "minLength": 1 },
            "input": { "type": "object" }
          },
          "required": ["contract", "input"]
        }
      },
      "allOf": [
        {
          "if": { "required": ["steps"] },
          "then": { "not": { "required": ["commands"] } }
        },
        {
          "if": { "required": ["commands"] },
          "then": { "not": { "required": ["steps"] } }
        }
      ]
    },
    "commandStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "as": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "expectError": { "type": "string", "minLength": 1 }
      },
      "required": ["command", "input"]
    },
    "advanceClockStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "advanceClock": {
          "type": "string",
          "pattern": "^P(?=\\d|T\\d)(?:\\d+Y)?(?:\\d+M)?(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+(?:\\.\\d+)?S)?)?$"
        }
      },
      "required": ["advanceClock"]
    },
    "commandOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "input": { "type": "object" }
      },
      "required": ["command", "input"]
    },
    "queryOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "input": { "type": "object" }
      },
      "required": ["query", "input"]
    },
    "then": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": { "$ref": "#/$defs/expectedObject" },
        "error": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/eventRef" }
        },
        "eventsMatch": { "enum": ["contains"] },
        "observe": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": { "type": "string", "minLength": 1 },
              "input": { "type": "object" },
              "expect": { "$ref": "#/$defs/expectedObject" }
            },
            "required": ["query", "input", "expect"]
          }
        }
      },
      "oneOf": [
        { "required": ["output"] },
        { "required": ["error"] }
      ],
      "allOf": [
        {
          "if": { "required": ["eventsMatch"] },
          "then": { "required": ["events"] }
        }
      ]
    },
    "expectedObject": {
      "oneOf": [
        { "$ref": "#/$defs/regularExpectedObject" },
        { "$ref": "#/$defs/expectedMatcher" }
      ]
    },
    "regularExpectedObject": {
      "type": "object",
      "propertyNames": { "not": { "pattern": "^\\$" } },
      "additionalProperties": { "$ref": "#/$defs/expectedValue" }
    },
    "expectedValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedValue" }
        },
        { "$ref": "#/$defs/regularExpectedObject" },
        { "$ref": "#/$defs/expectedMatcher" }
      ]
    },
    "expectedMatcher": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "$contains": { "type": "array", "items": { "$ref": "#/$defs/expectedValue" } } },
          "required": ["$contains"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "$unordered": { "type": "array", "items": { "$ref": "#/$defs/expectedValue" } } },
          "required": ["$unordered"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "$length": { "type": "integer", "minimum": 0 } },
          "required": ["$length"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "$absent": { "const": true } },
          "required": ["$absent"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "$any": { "const": true } },
          "required": ["$any"],
          "additionalProperties": false
        }
      ]
    }
  }
}
