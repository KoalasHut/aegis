{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Impact",
  "type": "object",
  "properties": {
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "properties": {
        "affected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "affected"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "reads",
        "writes"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "required",
        "optional"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "emits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "emits",
        "consumes"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "requires"
      ],
      "additionalProperties": false
    },
    "consumers": {
      "type": "object",
      "properties": {
        "known": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "known"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "breaking": {
          "type": "boolean"
        }
      },
      "required": [
        "breaking"
      ],
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blastRadius": {
      "type": "object",
      "properties": {
        "classification": {
          "enum": [
            "local",
            "bounded",
            "cross-context",
            "unknown"
          ]
        }
      },
      "required": [
        "classification"
      ],
      "additionalProperties": false
    },
    "unresolved": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "capability",
    "domain",
    "state",
    "dependencies",
    "events",
    "permissions",
    "consumers",
    "compatibility",
    "migration",
    "risks",
    "blastRadius"
  ],
  "additionalProperties": false
}
