{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Themed domain rule file",
  "description": "A YAML file contains one non-empty themed list of domain rules.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/domainRule" },
  "$defs": {
    "domainRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BR-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["invariant", "policy", "calculation", "constraint", "quality"]
        },
        "status": {
          "enum": ["proposed", "approved", "provisional", "extracted", "deprecated"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "decision": {
          "type": "string",
          "pattern": "^D-[A-Z][A-Z0-9-]*-[0-9]{3}$"
        },
        "rationale": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["law", "contract", "policy", "evidence", "other"]
            },
            "reference": { "type": "string", "minLength": 1 },
            "locator": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "reference"],
          "additionalProperties": false
        },
        "effectiveFrom": { "type": "string", "format": "date" },
        "supersedes": {
          "type": "string",
          "pattern": "^BR-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"
        },
        "decisionTable": {
          "type": "object",
          "properties": {
            "inputs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "outputs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "when": { "type": "object", "minProperties": 1 },
                  "then": { "type": "object", "minProperties": 1 }
                },
                "required": ["when", "then"],
                "additionalProperties": false
              }
            }
          },
          "required": ["inputs", "outputs", "rows"],
          "additionalProperties": false
        },
        "verification": { "enum": ["automated", "manual", "review"] }
      },
      "required": [
        "id", "title", "statement", "type", "status", "owner", "rationale", "verification"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
          "then": { "required": ["decision"] }
        },
        {
          "if": { "properties": { "type": { "const": "constraint" } }, "required": ["type"] },
          "then": { "required": ["source"] }
        },
        {
          "if": { "properties": { "status": { "const": "extracted" } }, "required": ["status"] },
          "then": {
            "required": ["source"],
            "properties": { "source": { "required": ["locator"] } }
          }
        },
        {
          "if": { "required": ["decisionTable"] },
          "then": { "properties": { "type": { "const": "calculation" } } }
        }
      ]
    }
  }
}
