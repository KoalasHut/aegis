{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waiver",
  "type": "object",
  "properties": {
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "expires": {
      "type": "string",
      "format": "date"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "rule",
    "reason",
    "owner",
    "expires",
    "decision"
  ],
  "additionalProperties": false
}
