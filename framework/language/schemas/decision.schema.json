{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.dev/framework/language/schemas/decision.schema.json",
  "title": "Decision log",
  "description": "An authoritative YAML list of decisions within one validation scope.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/decisionId" },
      "title": { "type": "string", "minLength": 1 },
      "question": { "type": "string", "minLength": 1 },
      "decision": { "type": "string", "minLength": 1 },
      "status": { "enum": ["proposed", "approved", "rejected", "superseded"] },
      "approver": { "type": "string", "minLength": 1 },
      "date": { "type": "string", "format": "date" },
      "source": { "type": "string", "minLength": 1 },
      "supersedes": {
        "$ref": "common.schema.json#/$defs/decisionId",
        "description": "The new decision records the old decision it replaces; the old decision becomes superseded and is otherwise retained."
      },
      "affects": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "required": ["id", "title", "question", "decision", "status"],
    "additionalProperties": false,
    "allOf": [
      {
        "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
        "then": { "required": ["approver", "date", "source"] }
      }
    ]
  }
}
