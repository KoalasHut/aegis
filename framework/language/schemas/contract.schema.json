{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "kind": {
          "enum": [
            "command",
            "query",
            "workflow",
            "subscription",
            "event",
            "port",
            "input",
            "output",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "required",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "required",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "meaning"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "semantics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "summary",
        "types",
        "input",
        "output",
        "errors",
        "semantics"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "resource",
            "value",
            "union"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ordered": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "required",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "extends": {
          "type": "string",
          "minLength": 1
        },
        "discriminator": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        },
        "variants": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "contract": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "contract"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "summary",
        "types",
        "semantics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "union"
              }
            }
          },
          "then": {
            "required": [
              "variants"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "fields"
                  ]
                },
                {
                  "required": [
                    "extends"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "fields"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "variants"
                  ]
                },
                {
                  "required": [
                    "discriminator"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
